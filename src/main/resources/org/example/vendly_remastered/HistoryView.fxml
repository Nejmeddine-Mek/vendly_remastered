<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="workspace" stylesheets="@MainViewStyles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.HistoryViewController">
    <children>

        <HBox alignment="CENTER_LEFT" spacing="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label fx:id="pageTitle" text="Sales History Log">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" /> <TextField fx:id="searchField" prefWidth="250.0" promptText="Search by Sale ID or Client..." styleClass="form-field" />
            </children>
        </HBox>

        <TableView fx:id="salesTable" styleClass="pos-table" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="320.0" AnchorPane.topAnchor="65.0">
            <columns>
                <TableColumn fx:id="colSaleId" prefWidth="85.0" text="Invoice ID" />
                <TableColumn fx:id="colDate" prefWidth="160.0" text="Date &amp; Time" />
                <TableColumn fx:id="colClient" prefWidth="130.0" text="Client" />
                <TableColumn fx:id="colTotal" prefWidth="110.0" text="Total Amount" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <VBox prefWidth="290.0" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-background-radius: 4;" AnchorPane.bottomAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="65.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label fx:id="transactionSummary" styleClass="total-card-title" text="Transaction Summary">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="employeeLabel" styleClass="form-label" text="Cashier Employee" textFill="#757575" />
                                <TextField fx:id="txtCashier" editable="false" focusTraversable="false" styleClass="form-field" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="profitLabel" styleClass="form-label" text="Net Calculated Profit" textFill="#757575" />
                                <TextField fx:id="txtProfit" editable="false" focusTraversable="false" style="-fx-text-fill: #2e7d32; -fx-font-weight: bold;" styleClass="form-field" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Button fx:id="btnOpenDetails" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="35.0" styleClass="action-btn-primary" text="View Full Items Details ➔" />
            </children>
        </VBox>

    </children>
</AnchorPane>
