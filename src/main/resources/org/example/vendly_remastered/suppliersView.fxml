<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="600.0" minWidth="900.0" styleClass="workspace" stylesheets="@MainViewStyles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.SuppliersViewController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <HBox spacing="20.0" VBox.vgrow="NEVER">
                    <children>

                        <VBox spacing="12.0" styleClass="form-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="supplierInfo" prefWidth="140.0" styleClass="form-label" text="%supplier.supplierLogisticsInfo" />
                                        <TextArea fx:id="supplierDetailsArea" editable="false" prefHeight="85.0" prefWidth="400.0" promptText="%supplier.selectedAreaPrompt" styleClass="form-field" wrapText="true" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="searchSuppliersLabel" prefWidth="140.0" styleClass="form-label" text="%supplier.searchSupplier" />
                                        <TextField fx:id="searchField" promptText="%supplier.searchSupplierPrompt" styleClass="form-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="TOP_CENTER" minWidth="210.0" prefWidth="210.0" spacing="10.0" styleClass="form-card">
                            <children>
                                <Button fx:id="addSupplierButton" mnemonicParsing="false" prefWidth="190.0" styleClass="action-btn-primary" text="%supplier.addSupplier" />
                                <Button fx:id="supplierDetailsButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-manage" text="%supplier.viewModifySupplier" />
                                <Button fx:id="processOrderButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-finance" text="%supplier.clearDebts" />
                                <Button fx:id="refreshButton" mnemonicParsing="false" prefWidth="190.0" styleClass="action-btn-secondary" text="%supplier.refresh" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox styleClass="form-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="supplierTableView" prefHeight="400.0" prefWidth="870.0" styleClass="pos-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" text="%supplier.ID" />
                                <TableColumn fx:id="colCompanyName" prefWidth="180.0" text="%supplier.companyName" />
                                <TableColumn fx:id="colContactName" prefWidth="140.0" text="%supplier.contactPerson" />
                                <TableColumn fx:id="colPhone" prefWidth="130.0" text="%supplier.phoneNumer" />
                                <TableColumn fx:id="colEmail" prefWidth="160.0" text="%supplier.email" />
                                <TableColumn fx:id="colBalanceOwed" prefWidth="110.0" text="%supplier.balanceOwed" />
                                <TableColumn fx:id="colCreatedBy" prefWidth="100.0" text="%supplier.createdBy" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>