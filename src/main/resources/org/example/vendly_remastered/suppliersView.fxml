<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="600.0" minWidth="900.0"
            styleClass="workspace"
            stylesheets="@MainViewStyles.css"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.vendly_remastered.controls.SuppliersViewController">
    <children>
        <VBox spacing="15.0"
              AnchorPane.bottomAnchor="15.0"
              AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0"
              AnchorPane.topAnchor="15.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <HBox spacing="20.0" VBox.vgrow="NEVER">
                    <children>

                        <VBox spacing="12.0" styleClass="form-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="supplierInfo" prefWidth="140.0" styleClass="form-label" text="Supplier Logistics Info:" />
                                        <TextArea fx:id="supplierDetailsArea" editable="false" prefHeight="85.0" prefWidth="400.0" promptText="Select a corporate supplier registry line to review supply contracts, open items, or address indexes..." styleClass="form-field" wrapText="true" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="searchSuppliersLabel" prefWidth="140.0" styleClass="form-label" text="Search Suppliers:" />
                                        <TextField fx:id="searchField" promptText="Enter Company Name, Contact Person, or Tax ID..." styleClass="form-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="TOP_CENTER" prefWidth="210.0" minWidth="210.0" spacing="10.0" styleClass="form-card">
                            <children>
                                <Button fx:id="addSupplierButton" mnemonicParsing="false" prefWidth="190.0" styleClass="action-btn-primary" text="🏢 Add New Supplier" />

                                <Button fx:id="supplierDetailsButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-manage" text="View &amp; Modify Company" />

                                <Button fx:id="processOrderButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-finance" text="📦 New Supply Order" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox styleClass="form-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="supplierTableView" prefHeight="400.0" prefWidth="870.0" styleClass="pos-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                                <TableColumn fx:id="colCompanyName" prefWidth="180.0" text="Company Name" />
                                <TableColumn fx:id="colContactName" prefWidth="140.0" text="Contact Person" />
                                <TableColumn fx:id="colPhone" prefWidth="130.0" text="Phone Number" />
                                <TableColumn fx:id="colEmail" prefWidth="160.0" text="Email Registry" />
                                <TableColumn fx:id="colTotalOrders" prefWidth="100.0" text="Orders Placed" />
                                <TableColumn fx:id="colBalanceOwed" prefWidth="110.0" text="Balance Owed" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
