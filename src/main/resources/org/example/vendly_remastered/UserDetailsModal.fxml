<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox minWidth="300.0" prefWidth="340.0" spacing="16.0" styleClass="total-card" stylesheets="@MainViewStyles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.UserDetailsModalController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header Section -->
    <VBox spacing="4.0">
        <Label fx:id="userDetailsLabel" styleClass="total-card-title" text="USER ACCOUNT PROFILE" />
        <Label styleClass="form-label-helper" text="View or update registry parameters" />
    </VBox>

    <!-- Form Container -->
    <VBox spacing="12.0" VBox.vgrow="ALWAYS">

        <VBox spacing="4.0">
            <Label style="-fx-text-fill: #64748B;" styleClass="form-label" text="User ID (Read Only)" />
            <TextField fx:id="txtUserId" editable="false" style="-fx-background-color: #1E293B; -fx-text-fill: #94A3B8; -fx-opacity: 0.8;" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="Username" />
            <TextField fx:id="txtUsername" promptText="e.g., n.eddine" styleClass="form-field" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="Full Name" />
            <TextField fx:id="txtFullName" promptText="e.g., Nejem Eddine" styleClass="form-field" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="Assigned Role" />
            <ComboBox fx:id="comboRole" maxWidth="1.7976931348623157E308" promptText="Select Authorization Level" styleClass="custom-combo-box" />
        </VBox>

        <!-- 🔒 Password Fields Layer -->
        <VBox spacing="4.0">
            <Label styleClass="form-label" text="Account Password" />
            <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="form-field" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="Confirm Password" />
            <PasswordField fx:id="txtConfirmPassword" promptText="••••••••" styleClass="form-field" />
        </VBox>
    </VBox>

    <!-- Context Actions Area -->
    <VBox spacing="10.0">
        <Button fx:id="userModifyButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="38.0" styleClass="btn-action-manage" text="Save Registry Changes" />

        <Button fx:id="toggleStatusButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="38.0" styleClass="logout-button" text="Deactivate Account" />
    </VBox>
</VBox>
