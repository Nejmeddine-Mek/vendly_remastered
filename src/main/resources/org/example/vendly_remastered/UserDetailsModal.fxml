<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox minWidth="300.0" prefWidth="340.0" spacing="16.0" styleClass="total-card" stylesheets="@MainViewStyles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.UserDetailsModalController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header Section -->
    <VBox spacing="4.0">
        <Label fx:id="userDetailsLabel" styleClass="total-card-title" text="%user_modal.header.title" />
        <Label styleClass="form-label-helper" text="%user_modal.header.subtitle" />
    </VBox>

    <!-- Form Container -->
    <VBox spacing="12.0" VBox.vgrow="ALWAYS">

        <VBox spacing="4.0">
            <Label style="-fx-text-fill: #64748B;" styleClass="form-label" text="%user_modal.label.user_id" />
            <TextField fx:id="txtUserId" editable="false" style="-fx-background-color: #1E293B; -fx-text-fill: #94A3B8; -fx-opacity: 0.8;" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="%user_modal.label.username" />
            <TextField fx:id="txtUsername" promptText="%user_modal.prompt.username" styleClass="form-field" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="%user_modal.label.fullname" />
            <TextField fx:id="txtFullName" promptText="%user_modal.prompt.fullname" styleClass="form-field" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="%user_modal.label.role" />
            <ComboBox fx:id="comboRole" maxWidth="1.7976931348623157E308" promptText="%user_modal.prompt.select_role" styleClass="custom-combo-box" />
        </VBox>

        <!-- 🔒 Password Fields Layer -->
        <VBox spacing="4.0">
            <Label styleClass="form-label" text="%user_modal.label.password" />
            <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="form-field" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="%user_modal.label.confirm_password" />
            <PasswordField fx:id="txtConfirmPassword" promptText="••••••••" styleClass="form-field" />
        </VBox>
    </VBox>

    <!-- Context Actions Area -->
    <VBox spacing="10.0">
        <Button fx:id="userModifyButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="38.0" styleClass="btn-action-manage" text="%user_modal.btn.save" />

        <Button fx:id="toggleStatusButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="38.0" styleClass="logout-button" text="%user_modal.btn.deactivate" />
    </VBox>
</VBox>