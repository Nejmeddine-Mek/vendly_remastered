<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="600.0" minWidth="900.0" styleClass="workspace" stylesheets="@MainViewStyles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.ProductsViewController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <children>
                <HBox spacing="20.0" VBox.vgrow="NEVER">
                    <children>
                        <VBox spacing="12.0" styleClass="form-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="selectedProdInfoLabel" prefWidth="130.0" styleClass="form-label" text="%products.selectedProdInfo" />
                                        <TextArea fx:id="productDetailsArea" editable="false" prefHeight="85.0" prefWidth="400.0" promptText="%products.selectedAreaPrompt" styleClass="form-field" wrapText="true" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="searchRegistryLabel" prefWidth="130.0" styleClass="form-label" text="%products.searchRegistry" />
                                        <TextField fx:id="searchField" promptText="%products.searchPrompt" styleClass="form-field" HBox.hgrow="ALWAYS" />

                                        <Label fx:id="categoryLabel" styleClass="form-label" text="%products.category" />
                                        <ComboBox fx:id="categoryFilterComboBox" prefWidth="180.0" promptText="%products.allCategories" styleClass="form-field" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="TOP_CENTER" minWidth="210.0" prefWidth="210.0" spacing="10.0" styleClass="form-card">
                            <children>
                                <Button fx:id="addProductButton" mnemonicParsing="false" prefWidth="190.0" styleClass="action-btn-primary" text="%products.addNewProdButton" />
                                <Button fx:id="productDetailsButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-manage" text="%products.viewModifyItem" />
                                <Button fx:id="adjustStockButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-finance" text="%products.adjustInventory" />
                                <Button fx:id="refreshButton" mnemonicParsing="false" prefWidth="190.0" styleClass="action-btn-secondary" text="%products.refresh" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox styleClass="form-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="productTableView" prefHeight="400.0" prefWidth="870.0" styleClass="pos-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSku" prefWidth="90.0" text="%products.SKUBarcode" />
                                <TableColumn fx:id="colName" prefWidth="180.0" text="%products.nameCol" />
                                <TableColumn fx:id="colCategory" prefWidth="120.0" text="%products.categoryCol" />
                                <TableColumn fx:id="colCostPrice" prefWidth="100.0" text="%products.costPriceCol" />
                                <TableColumn fx:id="colRetailPrice" prefWidth="100.0" text="%products.retailPrice" />
                                <TableColumn fx:id="colStockQty" prefWidth="90.0" text="%products.StockQty" />
                                <TableColumn fx:id="colMinThreshold" prefWidth="100.0" text="%products.minThreshold" />
                                <TableColumn fx:id="colStatus" prefWidth="90.0" text="%products.status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
