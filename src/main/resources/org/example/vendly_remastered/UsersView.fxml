<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" styleClass="workspace" stylesheets="" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.UsersViewController">
    <children>
        <VBox spacing="15.0" stylesheets="@MainViewStyles.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <HBox spacing="20.0" VBox.vgrow="NEVER">
                    <children>

                        <VBox spacing="10.0" styleClass="form-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="userDetailsLabel" styleClass="form-label" text="Selected User Profile:" />
                                        <TextArea fx:id="userDetailsArea" editable="false" prefHeight="85.0" prefWidth="450.0" promptText="Select a staff member row from the registry below to inspect profile configuration parameters..." styleClass="form-field" wrapText="true" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label fx:id="userSearchLabel" styleClass="form-label" text="Search Staff:" />
                                        <TextField fx:id="searchField" prefWidth="300.0" promptText="Search by Username, Full Name, or Role..." styleClass="form-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="TOP_CENTER" prefWidth="210.0" minWidth="210.0" spacing="10.0" styleClass="form-card">
                            <children>
                                <Button fx:id="addUserButton" mnemonicParsing="false" prefWidth="190.0" styleClass="action-btn-primary" text="➕ Provision New User" />

                                <Button fx:id="userModifyButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-manage" text="View &amp; Modify Profile" />

                                <Button fx:id="toggleStatusButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-finance" text="🔒 Deactivate / Activate" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox styleClass="form-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="userTableView" prefHeight="400.0" prefWidth="870.0" styleClass="pos-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUserId" prefWidth="60.0" text="User ID" />
                                <TableColumn fx:id="colUsername" prefWidth="130.0" text="Username" />
                                <TableColumn fx:id="colFullName" prefWidth="180.0" text="Full Name" />
                                <TableColumn fx:id="colRole" prefWidth="120.0" text="System Role" />
                                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Account Status" />
                                <TableColumn fx:id="colCreatedBy" prefWidth="120.0" text="Created By" />
                                <TableColumn fx:id="colCreatedAt" prefWidth="140.0" text="Created At" />
                                <TableColumn fx:id="colLastLogin" prefWidth="140.0" text="Last Login Audit" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>