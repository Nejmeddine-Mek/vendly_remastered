<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="400.0" style="-fx-background-color: #1E293B;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.LoginViewController">
    <children>
        <VBox alignment="CENTER" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>

                <VBox alignment="CENTER" spacing="6.0">
                    <children>
                        <Label fx:id="appNameLabel" text="VENDLY" textFill="WHITE">
                            <font>
                                <Font name="Segoe UI Bold" size="36.0" />
                            </font>
                        </Label>
                        <Label fx:id="sloganLabel" text="Enterprise Market ERP" textFill="#94A3B8">
                            <font>
                                <Font name="Segoe UI Regular" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="18.0" style="-fx-background-color: #334155; -fx-border-color: #475569; -fx-border-radius: 8px; -fx-background-radius: 8px;" styleClass="form-card">
                    <padding>
                        <Insets bottom="25.0" left="20.0" right="20.0" top="25.0" />
                    </padding>
                    <children>

                        <VBox spacing="6.0">
                            <children>
                                <Label fx:id="usernameLabel" style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Username or Email" textFill="WHITE" />
                                <TextField fx:id="usernameField" promptText="Enter your workspace ID..." style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-border-color: #475569;" styleClass="form-field" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label fx:id="passwordLabel" style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Password" textFill="WHITE" />
                                <PasswordField fx:id="passwordField" promptText="Enter security key..." style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-border-color: #475569;" styleClass="form-field" />
                            </children>
                        </VBox>

                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="loginButton" mnemonicParsing="false" prefHeight="44.0" prefWidth="320.0" style="-fx-font-size: 14px;" styleClass="action-btn-primary" text="Sign In to Workspace" />

                        <Label fx:id="errorLabel" style="-fx-font-weight: bold; -fx-font-size: 12px;" textFill="#EF4444" wrapText="true" />
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
