<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" styleClass="workspace" stylesheets="" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.vendly_remastered.controls.ClientsViewController">
    <children>
        <VBox spacing="15.0" stylesheets="@MainViewStyles.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <HBox spacing="20.0" VBox.vgrow="NEVER">
                    <children>

                        <VBox spacing="10.0" styleClass="form-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="clientDetailsLabel" styleClass="form-label" text="Selected Client Details:" />
                                        <TextArea fx:id="clientDetailsArea" editable="false" prefHeight="85.0" prefWidth="450.0" promptText="Select a client row from the registry below to inspect parameters..." styleClass="form-field" wrapText="true" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label fx:id="clientSearchLabel" styleClass="form-label" text="Search Clients:" />
                                        <TextField fx:id="searchField" prefWidth="300.0" promptText="Enter Name, Phone Number, or Client ID..." styleClass="form-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="TOP_CENTER" prefWidth="210.0" minWidth="210.0" spacing="10.0" styleClass="form-card">
                            <children>
                                <Button fx:id="addClientButton" mnemonicParsing="false" prefWidth="190.0" styleClass="action-btn-primary" text="➕ Add New Client" />

                                <Button fx:id="clientDetailsButton" mnemonicParsing="false"  prefWidth="190.0" styleClass="btn-action-manage" text="View &amp; Modify Client" />

                                <Button fx:id="processPaymentButton" mnemonicParsing="false" prefWidth="190.0" styleClass="btn-action-finance" text="💳 Clear / Pay Debt" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox styleClass="form-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="clientTableView" prefHeight="400.0" prefWidth="870.0" styleClass="pos-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                                <TableColumn fx:id="colFirstName" prefWidth="130.0" text="First Name" />
                                <TableColumn fx:id="colLastName" prefWidth="130.0" text="Last Name" />
                                <TableColumn fx:id="colPhone" prefWidth="140.0" text="Phone Number" />
                                <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email Address" />
                                <TableColumn fx:id="colPurchases" prefWidth="110.0" text="Total Purchases" />
                                <TableColumn fx:id="colDebts" prefWidth="110.0" text="Outstanding Debt" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
